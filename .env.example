# Discord Bot credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# PostgreSQL connection
# Local dev example: postgresql://postgres:password@localhost:5432/mojo_party_bot
DATABASE_URL=

# Optional: your test server's Guild ID.
# If set, slash commands update INSTANTLY (development mode).
# If left empty, commands are registered globally (can take up to 1 hour to propagate).
DISCORD_DEV_GUILD_ID=

# Environment: development / production
NODE_ENV=development
